# ── Configuração do CHUÁ (Docker) — OPCIONAL ────────────────────────────────
# O docker-compose já funciona sem este arquivo (usa os valores padrão abaixo).
# Para personalizar, copie para ".env" na mesma pasta do docker-compose.yml:
#     Windows:  copy .env.docker.example .env
#     Linux:    cp .env.docker.example .env

# Porta onde o app abre no navegador (padrão 8080 -> http://localhost:8080)
APP_PORT=8080

# Senha do banco PostgreSQL (use letras/números; evite @ e ! na senha)
DB_PASSWORD=Chua2026Secure

# Segredo usado para assinar os tokens de login.
# TROQUE por um texto aleatório longo em produção.
JWT_SECRET=troque_este_segredo_por_algo_aleatorio
